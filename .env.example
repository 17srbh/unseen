# Public Cognito identifiers. These values are safe to expose in a browser bundle;
# never put AWS access keys, client secrets or private credentials in VITE_ variables.
VITE_COGNITO_USER_POOL_ID=ap-south-1_REPLACE_ME
VITE_COGNITO_USER_POOL_CLIENT_ID=REPLACE_ME
# Domain host only: do not include https://
VITE_COGNITO_DOMAIN=REPLACE_ME.auth.ap-south-1.amazoncognito.com

# Public HTTPS base URL for the UNSEEN API. No trailing slash.
VITE_UNSEEN_API_URL=https://q3darm7zjg.execute-api.ap-south-1.amazonaws.com

# Optional overrides. Defaults use the current app origin.
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/auth/callback
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/
